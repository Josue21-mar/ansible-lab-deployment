# Fichier généré par Ansible — ne pas modifier à la main

server {
    listen 80;
    server_name {{ app_domain }};

    # Redirection systématique vers HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ app_domain }};

    ssl_certificate     /etc/ssl/certs/{{ app_domain }}.crt;
    ssl_certificate_key /etc/ssl/private/{{ app_domain }}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass         http://127.0.0.1:{{ nginx_upstream_port }};
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
    }
}
