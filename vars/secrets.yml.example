# Copier ce fichier en secrets.yml, renseigner le mot de passe,
# puis le chiffrer avant tout commit :
#
#   cp vars/secrets.yml.example vars/secrets.yml
#   ansible-vault encrypt vars/secrets.yml
#
# vars/secrets.yml (une fois chiffré) est ignoré par git — voir .gitignore.

postgresql_db_password: "change-me"
